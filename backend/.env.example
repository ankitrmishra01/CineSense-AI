# ─── Database ──────────────────────────────────────────────────────────────────
# LOCAL OUT-OF-THE-BOX OPTION (SQLite - Zero setup required):
DATABASE_URL=sqlite+aiosqlite:///cinesense_local.db
SYNC_DATABASE_URL=sqlite:///cinesense_local.db

# PRODUCTION / NEON POSTGRESQL OPTION:
# DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/cinesense
# SYNC_DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/cinesense

# ─── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=cinesense-local-dev-secret-key-32chars-min-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── TMDB (v3 API Key) ────────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here

# ─── Groq (LLM Intent Classification) ─────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ─── FAISS & FastEmbed ONNX ────────────────────────────────────────────────────
FAISS_INDEX_PATH=faiss_index/movies.index
FAISS_ID_MAP_PATH=faiss_index/id_map.json
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
FASTEMBED_CACHE_PATH=/tmp/fastembed_cache

# ─── App & Security ────────────────────────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://cine-sense-ai.vercel.app"]
